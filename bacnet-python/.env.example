# Example settings for bacnet-mcp. Copy to .env in the directory the server
# runs in (with `uv run --directory bacnet-python bacnet-mcp`, that is this
# directory) and adjust. Values already set in the process environment win.

# Local IPv4 address to bind. Add the prefix length of the building
# automation network (e.g. 192.168.1.10/24) to enable broadcast Who-Is.
BACNET_INTERFACE=127.0.0.1
BACNET_PORT=47808
# Device instance the server presents on the network; pick an unused one.
BACNET_DEVICE_INSTANCE=1234
BACNET_APDU_TIMEOUT_MS=3000
# Retries apply to reads only; a WriteProperty is never sent twice.
BACNET_APDU_RETRIES=3
BACNET_LOG_LEVEL=WARNING
# OBJECT_MAP_FILE=objects.json

# Safety switch: NOT read from a .env file that is found automatically.
# A .env in the working directory may belong to whatever project the MCP
# client is working in, so it must not be able to turn writes on. The server
# ignores the line below, with a warning on stderr, unless this file is
# passed explicitly with `bacnet-mcp --env-file PATH`. Otherwise set it in the
# process environment, e.g. the "env" block of your MCP client's config.
# BACNET_WRITES_ENABLED=false
