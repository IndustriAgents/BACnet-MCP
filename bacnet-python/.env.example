# Example settings for bacnet-mcp. Copy to bacnet-python/.env (this
# directory) and adjust. That is the ONLY .env the server reads on its own: a
# .env in its working directory or a parent is never read, and an installed
# package reads none. From this file only BACNET_* connection settings are
# used; anything else is ignored with a warning on stderr. Values already set
# in the process environment win. `bacnet-mcp --env-file PATH` reads every
# variable of the file you name.

# Local IPv4 address to bind. Add the prefix length of the building
# automation network (e.g. 192.168.1.10/24) to enable broadcast Who-Is.
BACNET_INTERFACE=127.0.0.1
BACNET_PORT=47808
# Device instance the server presents on the network; pick an unused one.
BACNET_DEVICE_INSTANCE=1234
BACNET_APDU_TIMEOUT_MS=3000
# Retries apply to reads only; a WriteProperty is never sent twice.
BACNET_APDU_RETRIES=3
BACNET_LOG_LEVEL=WARNING

# NOT read from this file (it decides where alias writes go): set it in the
# process environment or a file given with --env-file.
# OBJECT_MAP_FILE=objects.json

# Safety switch: NOT read from this file either, in any spelling. The server
# ignores the line below, with a warning on stderr, unless the file is passed
# explicitly with `bacnet-mcp --env-file PATH`. Otherwise set it in the
# process environment, e.g. the "env" block of your MCP client's config.
# BACNET_WRITES_ENABLED=false
