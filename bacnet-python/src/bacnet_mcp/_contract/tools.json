                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Address"
              },
              "target": {
                "const": "address",
                "type": "string"
              }
            },
            "required": [
              "device_id",
              "object_type",
              "object_instance",
              "target"
            ],
            "type": "object",
            "additionalProperties": false
          },
          {
            "properties": {
              "alias": {
