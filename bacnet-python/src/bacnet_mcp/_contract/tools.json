    {
      "name": "discover_devices",
      "description": "Find BACnet devices with Who-Is and collect their I-Am answers.\n\nWithout `address` the Who-Is is a global broadcast, which needs the\nserver's BACNET_INTERFACE to include a prefix length (for example\n192.168.1.10/24). With `address` it is sent to that one address, e.g.\n\"192.168.1.20\" or \"127.0.0.1:47809\" (the repository's mock device).\n\nArgs:\n    timeout_ms: How long to wait for I-Am answers (100-60000 ms).\n    address: Optional target: an IPv4 address with optional port\n        (\"ip\" or \"ip:port\"), or \"*\" / \"*:*\" for a broadcast.\n    low_limit: Lowest device instance to ask for (use with high_limit).\n    high_limit: Highest device instance to ask for (use with low_limit).\n    include_details: Also read each device's object-name, vendor-name and\n        model-name.\n\nReturns devices with device_id, address, vendor_id, max_apdu_length,\nsegmentation and (with include_details) name, vendor and model. Details\nget at most 10 s after the Who-Is; meta.details is \"complete\", or\n\"partial\" with details_partial set on the devices not fully read.",
      "inputSchema": {
        "properties": {
          "timeout_ms": {
            "default": 3000,
            "title": "Timeout Ms",
            "type": "integer",
            "description": "timeout ms for the selected operation; see its mode description."
          },
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Address",
            "description": "address for the selected operation; see its mode description."
          },
          "low_limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Low Limit",
            "description": "low limit for the selected operation; see its mode description."
          },
          "high_limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "High Limit",
            "description": "high limit for the selected operation; see its mode description."
          },
          "include_details": {
            "default": true,
            "title": "Include Details",
            "type": "boolean",
            "description": "include details for the selected operation; see its mode description."
          }
        },
        "title": "discover_devicesArguments",
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "success",
          "data",
