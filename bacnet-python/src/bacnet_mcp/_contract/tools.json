  "tools": [
    {
      "name": "read_property",
      "description": "Select one target mode and provide only its parameters.\n\naddress: Read one property of one object on a BACnet device (ReadProperty).\n\nThe device is found by its instance number: from an earlier\ndiscover_devices, from `address` (after checking that the device there\nis `device_id`), or by a Who-Is broadcast when the server has a\nbroadcast address.\n\nArgs:\n    device_id: Device instance number (0-4194302).\n    object_type: BACnet object type, e.g. \"analog-input\", \"binary-value\",\n        \"analog-output\", \"device\".\n    object_instance: Object instance number.\n    property_id: Property name, e.g. \"present-value\" (default),\n        \"object-name\", \"units\", \"status-flags\", \"priority-array\",\n        \"object-list\". May carry an index: \"priority-array[8]\".\n    array_index: Optional array index for array properties (0 = length).\n    address: Optional device address, \"ip\" or \"ip:port\", e.g.\n        \"127.0.0.1:47809\" for the mock. Its identity is checked first.\n\nReturns the decoded value: numbers, strings, enumeration names (e.g.\n\"active\"), lists for arrays, null for an empty priority slot, and\n\"NaN\" / \"Infinity\" / \"-Infinity\" for non-finite REALs.\n\nalias: Read the property an object-map alias points to (see list_objects).\n\nArgs:\n    alias: An alias from the object map.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "device_id": {
            "title": "Device Id",
            "type": "integer",
            "description": "device id for the selected operation; see its mode description."
          },
          "object_type": {
            "title": "Object Type",
            "type": "string",
            "description": "object type for the selected operation; see its mode description."
          },
          "object_instance": {
            "title": "Object Instance",
            "type": "integer",
            "description": "object instance for the selected operation; see its mode description."
          },
          "property_id": {
            "default": "present-value",
            "title": "Property Id",
            "type": "string",
            "description": "property id for the selected operation; see its mode description."
          },
          "array_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Array Index",
            "description": "array index for the selected operation; see its mode description."
          },
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Address",
            "description": "address for the selected operation; see its mode description."
          },
          "target": {
            "anyOf": [
              {
                "const": "address",
                "type": "string"
              },
              {
                "const": "alias",
                "type": "string"
              }
            ],
            "description": "Select the target mode described above."
          },
          "alias": {
            "title": "Alias",
            "type": "string",
            "description": "alias for the selected operation; see its mode description."
          }
        },
        "required": [
          "target"
        ],
        "oneOf": [
          {
            "properties": {
              "device_id": {
                "title": "Device Id",
                "type": "integer"
              },
              "object_type": {
                "title": "Object Type",
                "type": "string"
              },
              "object_instance": {
                "title": "Object Instance",
                "type": "integer"
              },
              "property_id": {
                "default": "present-value",
                "title": "Property Id",
                "type": "string"
              },
              "array_index": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
